{
  "name": "expyra",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "dotnet run --project apps/api/src/Expyra.WebApi",
    "api:build": "dotnet build apps/api",
    "api:test": "dotnet test apps/api",
    "api:migrate": "dotnet ef database update --project apps/api/src/Expyra.Infrastructure --startup-project apps/api/src/Expyra.WebApi",
    "api:seed": "dotnet run --project apps/api/src/Expyra.WebApi -- seed reference-data",
    "web": "pnpm --filter @expyra/web dev",
    "mobile": "pnpm --filter @expyra/mobile start",
    "types:generate": "pnpm --filter @expyra/shared-types generate",
    "db:up": "./scripts/db-up.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r build",
    "check": "pnpm run api:build && pnpm run api:test && pnpm -r lint && pnpm run typecheck && pnpm run test && pnpm -r build",
    "test": "pnpm -r --if-present test"
  }
}
